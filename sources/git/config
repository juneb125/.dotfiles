# This is Git's per-user configuration file.
[user]
	name = June B
	email = jrbergeron823@gmail.com

[init]
	defaultBranch = main

[core]
	# global .gitignore
	excludesFile = ~/.dotfiles/sources/git/ignore
	pager = less
	whitespace = error

[alias]
	aliases = !"sed 's/^alias.//; s/ / = /' <(git config get --regexp '^alias.') | sort"
	br = branch
	cam = commit -am
	cl = clone
	cliff = !git-cliff
	cm = commit -m
	cnom = commit --allow-empty-message -m ""
	co = checkout
	chp = cherry-pick
	i = init
	log = log --graph
	ls-aliases = aliases
	msg = !eval "bat $(git config 'commit.template') -l conf --style=numbers,grid"
	rl = reflog
	unadd = restore --staged
	uncommit = reset --soft HEAD~1
	wt = worktree

[commit]
	template = ~/.dotfiles/sources/git/template

[push]
	default = current
	followTags = true

[pull]
	default = current

[github]
	user = juneb125

[credential]
	helper = store

[diff]
	algorithm = histogram

[url "git@github.com"]
	insteadOf = "github"

