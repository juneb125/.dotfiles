# This is Git's per-user configuration file.
[user]
	name = June B
	email = jrbergeron823@gmail.com

[init]
	defaultBranch = main

[core]
	# global .gitignore
	excludesFile = ./ignore

[alias]
	aliases = !sed -E "s/^alias.//g; s/ / = /" <(git config --get-regexp '^alias.')
	br = branch
	cam = commit -am
	cl = clone
	cm = commit -m
	co = checkout
	i = init
	log = log --graph
	ls-aliases = aliases
	msg = !bat ${XDG_CONFIG_HOME}/git/template -l conf --style=numbers,grid
	rl = reflog
	unadd = restore --staged
	uncommit = reset --soft HEAD~1
	wt = worktree

[commit]
	template = ~/.dotfiles/sources/git/template

[push]
	default = current
	followTags = true

[pull]
	default = current

[github]
	user = juneb125

[credential]
	helper = store

[url "git@github.com"]
	insteadOf = "github"

